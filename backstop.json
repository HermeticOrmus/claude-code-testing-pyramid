{
  "id": "claude-testing-pyramid-visual",
  "viewports": [
    {
      "label": "phone",
      "width": 375,
      "height": 667
    },
    {
      "label": "tablet",
      "width": 768,
      "height": 1024
    },
    {
      "label": "desktop",
      "width": 1920,
      "height": 1080
    }
  ],
  "scenarios": [
    {
      "label": "Homepage",
      "url": "http://localhost:3000",
      "delay": 500,
      "misMatchThreshold": 0.1
    }
  ],
  "paths": {
    "bitmaps_reference": "examples/visual/backstop/reference",
    "bitmaps_test": "examples/visual/backstop/test",
    "engine_scripts": "examples/visual/backstop/scripts",
    "html_report": "examples/visual/backstop/report/html",
    "ci_report": "examples/visual/backstop/report/ci"
  },
  "report": ["browser", "json"],
  "engine": "playwright",
  "engineOptions": {
    "browser": "chromium"
  },
  "asyncCaptureLimit": 5,
  "asyncCompareLimit": 50,
  "debug": false,
  "debugWindow": false
}
