{
  "name": "claude-code-testing-pyramid",
  "version": "1.0.0",
  "description": "Complete testing guide: unit, integration, E2E, visual regression, load testing. Jest, Playwright, k6, Pact. Multi-language patterns built with Claude Code.",
  "keywords": [
    "testing",
    "unit-testing",
    "integration-testing",
    "e2e-testing",
    "jest",
    "vitest",
    "playwright",
    "cypress",
    "pytest",
    "load-testing",
    "k6",
    "visual-regression",
    "mutation-testing",
    "contract-testing",
    "claude-code",
    "test-automation",
    "quality-assurance",
    "hermetic-technology"
  ],
  "author": "Hermetic Ormus",
  "license": "MIT",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --coverage",
    "test:unit:watch": "jest --watch",
    "test:unit:vitest": "vitest run",
    "test:integration": "jest --config jest.integration.config.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:cypress": "cypress run",
    "test:e2e:cypress:open": "cypress open",
    "test:visual": "backstop test",
    "test:visual:reference": "backstop reference",
    "test:mutation": "stryker run",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitest/ui": "^1.1.0",
    "backstopjs": "^6.3.4",
    "cypress": "^13.6.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "msw": "^2.0.11",
    "nock": "^13.5.0",
    "playwright": "^1.40.1",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "testcontainers": "^10.4.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "@stryker-mutator/core": "^8.0.0",
    "@stryker-mutator/jest-runner": "^8.0.0",
    "@stryker-mutator/typescript-checker": "^8.0.0",
    "@pact-foundation/pact": "^12.1.1",
    "@percy/cli": "^1.27.6",
    "@percy/playwright": "^1.0.4"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "mongodb": "^6.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
